# Copy this file to .env and fill in real values before deploying.
# (Requires python-dotenv, or configure these as real environment
# variables on your server / hosting platform.)

DJANGO_SECRET_KEY=change-this-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Optional: enables richer nearby-place search (ratings, hours) via Google
# Places instead of the free OpenStreetMap Overpass API.
GOOGLE_PLACES_API_KEY=

# Only needed if you switch settings.py to PostgreSQL:
DB_NAME=blood_report_db
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
