SESSION_SECRET=replace-with-a-long-random-secret
ADMIN_EMAILS=admin@example.com

# Data storage: use "file" for storage/runtime-data.json or "google-sheets".
DATA_STORE_BACKEND=file

# Google Sheets storage. Create a spreadsheet, enable the Google Sheets API,
# share the spreadsheet with the service-account email as Editor, then fill these in.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----\n"

# Instead of the email/private-key values above, server environments may use
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# SMTP is required to send password-reset OTPs by email.
# With these values empty, development mode prints the OTP in the server terminal.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional location providers. OpenStreetMap is used by default.
NOMINATIM_REVERSE_URL=https://nominatim.openstreetmap.org/reverse
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
